rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    // 1. Employees Collection
    match /employees/{employeeId} {
      allow read, write: if isValidDocId(employeeId);
    }

    // 2. Schools Collection
    match /schools/{schoolId} {
      allow read, write: if isValidDocId(schoolId);
    }

    // 3. Special Orders Collection
    match /specialOrders/{specialOrderId} {
      allow read, write: if isValidDocId(specialOrderId);
    }

    // 4. Earned Service Credits Collection
    match /earnedCredits/{earnedCreditId} {
      allow read, write: if isValidDocId(earnedCreditId);
    }

    // 5. Used Service Credits Collection
    match /usedCredits/{usedCreditId} {
      allow read, write: if isValidDocId(usedCreditId);
    }

    // 6. Leave Records Collection
    match /leaveRecords/{leaveRecordId} {
      allow read, write: if isValidDocId(leaveRecordId);
    }

    // 7. Promotions History Collection
    match /promotions/{promotionId} {
      allow read, write: if isValidDocId(promotionId);
    }

    // 8. School Assignments History Collection
    match /schoolAssignments/{assignmentId} {
      allow read, write: if isValidDocId(assignmentId);
    }

    // 9. Deleted Records Archive Collection
    match /deletedRecords/{recordId} {
      allow read, write: if isValidDocId(recordId);
    }

    // 10. Test / Diagnostic Collection
    match /test/{testId} {
      allow read, write: if true;
    }

    // Default Deny for unknown paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
