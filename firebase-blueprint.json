{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "DepEd Guimba West District personnel record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "firstName": { "type": "string", "maxLength": 100 },
        "middleName": { "type": "string", "maxLength": 100 },
        "lastName": { "type": "string", "maxLength": 100 },
        "extensionName": { "type": "string", "maxLength": 20 },
        "birthday": { "type": "string", "maxLength": 50 },
        "employeeNumber": { "type": "string", "maxLength": 50 },
        "currentPosition": { "type": "string", "maxLength": 100 },
        "itemNumber": { "type": "string", "maxLength": 100 },
        "dateOfLatestAppointment": { "type": "string", "maxLength": 50 },
        "dateOfOriginalAppointment": { "type": "string", "maxLength": 50 },
        "appointmentDocumentUrl": { "type": "string", "maxLength": 300000 },
        "appointmentDriveFileId": { "type": "string", "maxLength": 256 },
        "appointmentDriveFileName": { "type": "string", "maxLength": 256 },
        "profilePhotoUrl": { "type": "string", "maxLength": 300000 },
        "photoDriveFileId": { "type": "string", "maxLength": 256 },
        "photoDriveFileName": { "type": "string", "maxLength": 256 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "tinNumber": { "type": "string", "maxLength": 50 },
        "lbpAccountNumber": { "type": "string", "maxLength": 50 },
        "gsisNumber": { "type": "string", "maxLength": 50 },
        "philhealthNumber": { "type": "string", "maxLength": 50 },
        "pagibigNumber": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "firstName", "lastName", "employeeNumber", "currentPosition", "status"]
    },
    "School": {
      "title": "School",
      "description": "Public school within Guimba West District",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "status"]
    },
    "SpecialOrder": {
      "title": "SpecialOrder",
      "description": "DepEd Division Special Order authorizing service credits",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "soNumber": { "type": "string", "maxLength": 100 },
        "soDate": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 300 },
        "soDocumentUrl": { "type": "string", "maxLength": 300000 },
        "driveFileId": { "type": "string", "maxLength": 256 },
        "driveFileName": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "soNumber", "soDate", "title"]
    },
    "ServiceCreditEarned": {
      "title": "ServiceCreditEarned",
      "description": "Service credits granted to an employee under a specific Special Order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "soId": { "type": "string", "maxLength": 128 },
        "soNumber": { "type": "string", "maxLength": 100 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "earnedCredits": { "type": "number" },
        "remarks": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "soId", "soNumber", "employeeId", "earnedCredits"]
    },
    "ServiceCreditUsed": {
      "title": "ServiceCreditUsed",
      "description": "Service credits deducted/utilized from a specific Special Order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "maxLength": 128 },
        "soId": { "type": "string", "maxLength": 128 },
        "soNumber": { "type": "string", "maxLength": 100 },
        "dateUsed": { "type": "string", "maxLength": 50 },
        "usedCredits": { "type": "number" },
        "remarks": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "employeeId", "soId", "soNumber", "dateUsed", "usedCredits"]
    },
    "LeaveRecord": {
      "title": "LeaveRecord",
      "description": "Official leave record filed by district personnel",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "maxLength": 128 },
        "leaveType": { "type": "string", "maxLength": 100 },
        "dateFrom": { "type": "string", "maxLength": 50 },
        "dateTo": { "type": "string", "maxLength": 50 },
        "numberOfDays": { "type": "number" },
        "remarks": { "type": "string", "maxLength": 500 },
        "documentUrl": { "type": "string", "maxLength": 300000 },
        "driveFileId": { "type": "string", "maxLength": 256 },
        "driveFileName": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "employeeId", "leaveType", "dateFrom", "dateTo", "numberOfDays"]
    },
    "PromotionRecord": {
      "title": "PromotionRecord",
      "description": "Appointment and promotion history for district personnel",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "maxLength": 128 },
        "position": { "type": "string", "maxLength": 100 },
        "itemNumber": { "type": "string", "maxLength": 100 },
        "appointmentDate": { "type": "string", "maxLength": 50 },
        "appointmentPaperUrl": { "type": "string", "maxLength": 300000 },
        "driveFileId": { "type": "string", "maxLength": 256 },
        "driveFileName": { "type": "string", "maxLength": 256 },
        "remarks": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "employeeId", "position", "itemNumber", "appointmentDate"]
    },
    "SchoolAssignmentRecord": {
      "title": "SchoolAssignmentRecord",
      "description": "School transfer and reassignment history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "effectiveDateFrom": { "type": "string", "maxLength": 50 },
        "effectiveDateTo": { "type": "string", "maxLength": 50 },
        "remarks": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "employeeId", "schoolId", "schoolName", "effectiveDateFrom"]
    },
    "DeletedRecord": {
      "title": "DeletedRecord",
      "description": "Archived/trash record for audit logging and restoration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "originalId": { "type": "string", "maxLength": 128 },
        "recordType": { "type": "string", "maxLength": 50 },
        "deletedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "originalId", "recordType", "deletedAt"]
    }
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "DepEd Guimba West District personnel records"
    },
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "District public school list"
    },
    "/specialOrders/{specialOrderId}": {
      "schema": "SpecialOrder",
      "description": "Division special orders for service credits"
    },
    "/earnedCredits/{earnedCreditId}": {
      "schema": "ServiceCreditEarned",
      "description": "Earned service credits log"
    },
    "/usedCredits/{usedCreditId}": {
      "schema": "ServiceCreditUsed",
      "description": "Utilized service credits log"
    },
    "/leaveRecords/{leaveRecordId}": {
      "schema": "LeaveRecord",
      "description": "Personnel leave filing records"
    },
    "/promotions/{promotionId}": {
      "schema": "PromotionRecord",
      "description": "Personnel promotion and appointment histories"
    },
    "/schoolAssignments/{assignmentId}": {
      "schema": "SchoolAssignmentRecord",
      "description": "Personnel school assignment history"
    },
    "/deletedRecords/{recordId}": {
      "schema": "DeletedRecord",
      "description": "Archived records for recycle bin"
    }
  }
}
